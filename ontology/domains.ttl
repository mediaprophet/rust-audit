# Domain vocabulary for function classification.
# ------------------------------------------------------------------
# FORMAT CONSTRAINT: this file is loaded by audit-core's line-subset
# parser — keep ONE `subject predicate object .` triple per line.
# Add domains by appending a block in the same shape. To extend a
# domain, just add more `audit:keyword` lines for its subject.

@prefix audit: <https://audit.dev/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

audit:dom_physics a audit:Domain .
audit:dom_physics audit:label "physics" .
audit:dom_physics audit:keyword "physics" .
audit:dom_physics audit:keyword "simulate" .
audit:dom_physics audit:keyword "integrator" .
audit:dom_physics audit:keyword "euler" .
audit:dom_physics audit:keyword "runge kutta" .
